# 复制为 .env 并填入你自己的凭据。
# 本项目不会提交 .env —— 请勿把真实密钥写进任何被跟踪的文件。

# tushare Pro token（必填）
# 获取地址: https://tushare.pro/user/token
TUSHARE_TOKEN=

# 本地 TimescaleDB / PostgreSQL 连接（必填）
ETF_DB_HOST=127.0.0.1
ETF_DB_PORT=5432
ETF_DB_NAME=timescaledb
ETF_DB_USER=postgres
ETF_DB_PASSWORD=

# 回溯交易日数（可选，默认 120）
ETF_HISTORY_DAYS=120

# Wind MCP key（可选，仅季度机构持有比例需要）
WIND_API_KEY=
