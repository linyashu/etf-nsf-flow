      "description": "板块筛选。无外层容器，直接平铺，激活态提亮背景。",
      "html": "<button class=\"ds-chip ds-chip-active\">宽基</button>",
      "css": ".ds-chip{border:0;background:transparent;color:var(--dsw-alias-label-secondary);font-size:12px;padding:4px 8px;border-radius:6px;cursor:pointer;transition:background .15s,color .15s;}.ds-chip:hover{background:var(--dsw-alias-interactive-bg-hover);color:var(--dsw-alias-label-primary);}.ds-chip-active{background:var(--dsw-alias-bg-layer-2);color:var(--dsw-alias-label-primary);}"
    },
    {
      "name": "Search Input",
      "kind": "input",
      "refersTo": "input-search",
      "description": "ETF 搜索框。placeholder 必须显式覆盖 opacity，否则只有 3.55:1。",
      "html": "<input class=\"ds-input\" type=\"search\" placeholder=\"名称或代码\">",
      "css": ".ds-input{background:var(--dsw-alias-bg-layer-2);border:1px solid var(--dsw-alias-border-l1);border-radius:8px;padding:4px 12px;font-size:12px;color:var(--dsw-alias-label-primary);height:26px;outline:none;transition:border-color .15s;}.ds-input::placeholder{color:var(--dsw-alias-label-secondary);opacity:1;}.ds-input:focus{border-color:var(--dsw-alias-border-l2);}"
    },
    {
      "name": "Progress Bar",
      "kind": "custom",
      "description": "分位条。参与评分的指标用实心强调色，描述性指标用描边轨道 + 中性填充——同样的形状不能同时表示信号与非信号。",
      "html": "<div class=\"ds-bar ds-bar-signal\"><i style=\"width:72%\"></i></div>",
      "css": ".ds-bar{position:relative;height:4px;border-radius:2px;background:var(--dsw-alias-bg-layer-2);overflow:hidden;}.ds-bar i{position:absolute;inset:0 auto 0 0;display:block;border-radius:2px;}.ds-bar-signal i{background:color-mix(in srgb,var(--dsw-alias-state-error-primary) 72%,var(--dsw-alias-label-primary));}.ds-bar-desc{background:transparent;border:1px solid var(--dsw-alias-border-l2);}.ds-bar-desc i{background:var(--dsw-alias-label-tertiary);opacity:.6;}"
    },
